# Dockerfile.report — the daily QuantCore job (main.py).
#
# main.py sends the Discord notifications (price/moving-average breaches and
# Harvester rung hits), captures the daily options chains, and warms the
# fundamentals cache, calling the services layer IN-PROCESS (never the REST
# tier — Rule 6 / anti-pattern 5). It reads John's positions and the shared
# watchlist from the DB and fetches prices. Since issue #147 it no longer
# renders the HTML report — that is scripts/generate_portfolio_report.py, run
# from the Raspberry Pi, and its matplotlib/jinja2/boto3 stack is deliberately
# not installed here. main.py also does NOT score sentiment, so this image uses
# the LEAN dependency set (requirements-base.txt) — no torch/transformers.
#
# The service name kept the "report" spelling for continuity; the work did not.
#
# Designed to run once and exit (a Cloud Run Job triggered by Cloud Scheduler).

# ---- builder ----
FROM python:3.12-slim AS builder

ENV PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PYTHONDONTWRITEBYTECODE=1

RUN apt-get update && apt-get install -y --no-install-recommends gcc \
    && rm -rf /var/lib/apt/lists/*

RUN python -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

COPY requirements-base.txt ./
RUN pip install --upgrade pip && pip install -r requirements-base.txt

# ---- final ----
FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PATH="/opt/venv/bin:$PATH"

RUN useradd --create-home --uid 1000 appuser
COPY --from=builder /opt/venv /opt/venv

WORKDIR /app
COPY . .

# main.py appends to notification.log in the workdir (that file is how
# send_notifications() dedupes within a run); COPY leaves /app root-owned, so
# give appuser ownership of the dir. The job runs unprivileged, and a
# read-only workdir would make every notification the first one.
RUN chown appuser:appuser /app

USER appuser

# Run the report once and exit (Cloud Run Job semantics).
CMD ["python", "main.py"]
